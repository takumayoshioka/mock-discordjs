{
  "name": "@takumayoshioka/mock-discordjs",
  "version": "0.0.1",
  "description": "",
  "license": "MIT",
  "author": "Takuma Yoshioka",
  "type": "module",
  "main": "index.js",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "vitest": "^4.1.10"
  },
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "mock-discordjs-src": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#test/*": {
      "types": "./test/*.ts",
      "mock-discordjs-src": "./test/*.ts"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json",
    "compile": "tsc -p tsconfig.build.json",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}